{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "mvp/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?_path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?_path=$1"
    }
  ]
}
